GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=playground-generic #TODO:<CHANGE_ME>
GOOGLE_CLOUD_LOCATION=us-central1

GOOGLE_CLOUD_FIRESTORE=live-smartcamera


#SUBAGENT_LITE_MODEL=gemini-3.1-flash-lite
SUBAGENT_LITE_MODEL=gemini-3.5-flash-lite
SUBAGENT_LITE_CLOUD_LOCATION=global
#global

#LIVEAGENT_VERTEXAI_MODEL=gemini-live-2.5-flash-native-audio
LIVEAGENT_VERTEXAI_MODEL=gemini-3.8-live
LIVEAGENT_GEMINI_MODEL=gemini-3.1-flash-live-preview

# Agent architecture default for sessions that don't pass ?arch= (v1 never does)
#   monolithic = single Live agent with all rules + tools (original behaviour)
#   brain      = thin Live voice layer + cacheable Flash Lite brain (brain.py); v2 opts in via ?arch=brain
SMARTHOME_AGENT_ARCH=monolithic
BRAIN_THINKING_LEVEL=MEDIUM

# Brain sub-agent overrides (default to SUBAGENT_LITE_MODEL / SUBAGENT_LITE_CLOUD_LOCATION)
#BRAIN_MODEL=gemini-3.5-flash-lite
#BRAIN_CLOUD_LOCATION=global
#BRAIN_MAX_STEPS=6

# =========================================================================
# Estimated Cost panel (pricing.py) - USD per 1M tokens, Vertex AI STANDARD
# tier, prompts <= 200K tokens. Source:
# https://cloud.google.com/gemini-enterprise-agent-platform/generative-ai/pricing
# =========================================================================
# Live voice model (LIVEAGENT_VERTEXAI_MODEL = gemini-3.8-live) - no cache pricing
PRICE_LIVE_TEXT_INPUT_PER_M=0.75
PRICE_LIVE_AUDIO_INPUT_PER_M=3.00
PRICE_LIVE_IMAGE_INPUT_PER_M=1.00
PRICE_LIVE_TEXT_OUTPUT_PER_M=4.50
PRICE_LIVE_AUDIO_OUTPUT_PER_M=12.00

# Flash Lite sub-agents: camera checks + brain (SUBAGENT_LITE_MODEL / BRAIN_MODEL = gemini-3.5-flash-lite)
PRICE_LITE_INPUT_PER_M=0.30
PRICE_LITE_OUTPUT_PER_M=2.50
# Cached INPUT only (standard context-cache rate = 10% of input); output is never cached
PRICE_LITE_CACHED_INPUT_PER_M=0.03
